#!/bin/bash
# Nexthop-specific site-local configuration sourced by fboss/oss/scripts/bazel.sh.
# See fboss-build.env.example for documentation of the available variables.

GETDEPS_CACHE_URL="http://bucket.internal.nexthop.ai:7480/image-stash/getdeps-cache"
SCCACHE_SCHEDULER_HOST="sccache.us-west-1.nexthop.ai"
# Not a secret: sccache auth tokens are low-privilege identifiers used only to
# attribute cache usage, not to protect any sensitive data.
SCCACHE_AUTH_TOKEN="5420f48ebbdafef316daab08ca28a88918bb531cec5929753c593279990d61089d4695a3d06ffc134ac000cc65b810d6bf76ccf204121e262d4fa77531ec874b"
SCCACHE_EXTRA_DIST_CONFIG="remote_only = true"
BAZEL_REMOTE_CACHE_URL="http://bazel-remote.k8s.us-west-1.nexthop.ai"

# S3-compatible bucket for sccache's compilation result cache (distinct from
# SCCACHE_SCHEDULER_HOST above, which only handles distributed-compile job
# dispatch). Read by bazel-sccache-setup.sh; the cmake path gets the same
# values via nhfboss-common.sh.
SCCACHE_ENDPOINT="bucket.internal.nexthop.ai:7480"
SCCACHE_BUCKET="sccache"
SCCACHE_S3_KEY_PREFIX="fboss"
SCCACHE_REGION="auto"
AWS_ACCESS_KEY_ID="R74SNIY3OLH45CN19OWC"
AWS_SECRET_ACCESS_KEY="4rsA7lOZU0JbX81SZSTQ3nDs2ZslKlcvPdIgdOMP"

# Tests excluded from `bazel test //fboss/...` runs.  These are tests that are
# outside Nexthop's scope of work or are known-flaky upstream.  Appended as
# negative target patterns (-- -//target) by bazel.sh when running tests.
BAZEL_TEST_EXCLUDE_TARGETS=(
  # Flaky FSDB tests: DeltaPublisherTest, FsdbPubSubManager, PathPublisherTest,
  # StreamPublisherTest.overflowQueue/pipeResetWhenServeStreamStuck
  "//fboss/fsdb/client/test:fsdb_client_tests"
  # NOTE: fsdb_pub_sub_tests (StreamClientTest, FsdbPublisherTest) and
  # fsdb_cgo_wrapper_test (FsdbCgoPubSubWrapperTest) are already marked
  # "# bazelify: exclude" in their BUCK files — they have no BUILD.bazel
  # and never run in the Bazel build, so no exclusion needed here.
  # Flaky rackmon test: RackmonTest.DormantRecovery
  "//fboss/platform/rackmon:rackmon_test"
)

# Auto-download and initialize the prebuilt SAI implementation if needed.
# Logic lives in ensure-sai.sh (also called directly by the GARM CI workflow).
_fboss_ensure_sai_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bash "${_fboss_ensure_sai_dir}/ensure-sai.sh"
unset _fboss_ensure_sai_dir
