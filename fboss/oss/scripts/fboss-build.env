#!/bin/bash
# Nexthop-specific site-local configuration sourced by fboss/oss/scripts/bazel.sh.
# See fboss-build.env.example for documentation of the available variables.

GETDEPS_CACHE_URL="http://bucket.internal.nexthop.ai:7480/image-stash/getdeps-cache"
SCCACHE_SCHEDULER_HOST="sccache.us-west-1.nexthop.ai"
# Not a secret: sccache auth tokens are low-privilege identifiers used only to
# attribute cache usage, not to protect any sensitive data.
SCCACHE_AUTH_TOKEN="5420f48ebbdafef316daab08ca28a88918bb531cec5929753c593279990d61089d4695a3d06ffc134ac000cc65b810d6bf76ccf204121e262d4fa77531ec874b"
SCCACHE_EXTRA_DIST_CONFIG="remote_only = true"
BAZEL_REMOTE_CACHE_URL="http://bazel-remote.k8s.us-west-1.nexthop.ai"

# Tests excluded from `bazel test //fboss/...` runs.  These are tests that are
# outside Nexthop's scope of work or are known-flaky upstream.  Appended as
# negative target patterns (-- -//target) by bazel.sh when running tests.
BAZEL_TEST_EXCLUDE_TARGETS=(
  # Flaky FSDB tests: DeltaPublisherTest, FsdbPubSubManager, PathPublisherTest,
  # StreamPublisherTest.overflowQueue/pipeResetWhenServeStreamStuck
  "//fboss/fsdb/client/test:fsdb_client_tests"
  # NOTE: fsdb_pub_sub_tests (StreamClientTest, FsdbPublisherTest) and
  # fsdb_cgo_wrapper_test (FsdbCgoPubSubWrapperTest) are already marked
  # "# bazelify: exclude" in their BUCK files — they have no BUILD.bazel
  # and never run in the Bazel build, so no exclusion needed here.
  # Flaky rackmon test: RackmonTest.DormantRecovery
  "//fboss/platform/rackmon:rackmon_test"
)

# Auto-download and initialize the prebuilt SAI implementation if needed.
# The tarball is cached under /var/extras/sai/<version>/ (usually the host's
# $HOME/work/caches directory mounted into the build container).  Set
# SAI_VERSION in the environment to override the default version.  To force a
# re-download without waiting for an S3 ETag change, delete
# build/fbcode_builder/manifests/sai_impl from the repo root.
_fboss_ensure_sai() {
  local sai_version="${SAI_VERSION:-1.16.1}"
  local s3_url="http://bucket.internal.nexthop.ai:7480/vol-shared/fboss/sai/libsai_impl-${sai_version}-fboss.tar.gz"
  local cache_dir="/var/extras/sai/${sai_version}"
  local tarball="${cache_dir}/libsai_impl.tar.gz"
  local etag_file="${cache_dir}/.etag"
  local script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  local repo_root="$(cd "${script_dir}/../../.." && pwd)"
  local sai_impl_manifest="${repo_root}/build/fbcode_builder/manifests/sai_impl"
  local fboss_manifest="${repo_root}/build/fbcode_builder/manifests/fboss"

  # Quick HEAD request to detect upstream tarball updates (5 s timeout;
  # silently skipped when the S3 bucket is unreachable).
  local s3_etag
  s3_etag=$(curl --silent --max-time 5 --head "$s3_url" 2>/dev/null \
    | grep -i '^etag:' | tr -d '\r' | awk '{print $2}')

  # Nothing to do if SAI is already initialized and the S3 ETag matches.
  if [ -f "$sai_impl_manifest" ] \
     && grep -q '^sai_impl$' "$fboss_manifest" 2>/dev/null; then
    if [ -z "$s3_etag" ] \
       || { [ -f "$etag_file" ] && [ "$s3_etag" = "$(cat "$etag_file")" ]; }; then
      return 0
    fi
    echo "SAI ${sai_version}: updated tarball detected on S3, refreshing..." >&2
  fi

  echo "Downloading SAI ${sai_version}..." >&2
  mkdir -p "$cache_dir"
  if ! curl --fail -o "$tarball" "$s3_url"; then
    echo "ERROR: failed to download ${s3_url}" >&2
    return 1
  fi
  [ -n "$s3_etag" ] && printf '%s\n' "$s3_etag" > "$etag_file"

  echo "Initializing SAI ${sai_version}..." >&2
  python3 "${script_dir}/build-helper.py" \
    "$cache_dir" "$cache_dir" "$cache_dir" "$sai_version" \
    --skip-archive-creation
}
_fboss_ensure_sai
unset -f _fboss_ensure_sai
