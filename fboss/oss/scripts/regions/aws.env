# Build endpoints for the AWS us-east-2 region. Same keys as cloudstack.env;
# empty means the region has no such service.

# sccache-dist client config for the us-east-2 scheduler.
NH_SCCACHE_DIST_CONF=regions/sccache-dist.aws.toml

# Offer the farm what it has: two r7a.8xlarge workers at 37 slots each (6.9 GiB
# per slot). Offering more only queues in client retries; see nhfboss-common.sh.
NHFBOSS_COMPILE_JOBS=72

# sccache object cache: real S3, credentials from the instance profile.
NH_SCCACHE_BUCKET=sccache-east
NH_SCCACHE_ENDPOINT=s3.us-east-2.amazonaws.com:443
NH_SCCACHE_S3_USE_SSL=true
NH_SCCACHE_REGION=us-east-2
NH_SCCACHE_S3_KEY_PREFIX=fboss
NH_SCCACHE_AWS_ACCESS_KEY_ID=
NH_SCCACHE_AWS_SECRET_ACCESS_KEY=

# No pkgproxy reachable: getdeps downloads go upstream.
NH_PKGPROXY_URL=

# No static_deps mirror: the kernel source is fetched upstream.
NH_STATIC_DEPS_HTTP=
NH_STATIC_DEPS_S3=
NH_STATIC_DEPS_ENDPOINT=

# No RPM mirror: the kiwi image repositories use the upstream metalinks.
NH_RPM_MIRROR=
