# Build endpoints for the on-prem CloudStack region. The builder containers load
# ../region.env with `docker run --env-file`; set-region.sh (run by the fboss
# genrules with --action_env=NH_CLOUD_PROVIDER, or by hand through
# `bazel run //fboss:set_region -- <region>`) points that link at one of the
# regions/*.env files. There is no default.
# Format: KEY=VALUE, no quotes, no `export`. Every key must exist in every region.

# sccache-dist client config (scheduler URL and token), relative to fboss/oss/scripts.
NH_SCCACHE_DIST_CONF=regions/sccache-dist.cloudstack.toml

# sccache object cache: Ceph RGW, plain HTTP, path-style. Ceph needs static
# keys; these are low-privilege usage-attribution keys, not secrets.
NH_SCCACHE_BUCKET=sccache
NH_SCCACHE_ENDPOINT=bucket.internal.nexthop.ai:7480
NH_SCCACHE_S3_USE_SSL=
NH_SCCACHE_REGION=auto
NH_SCCACHE_S3_KEY_PREFIX=fboss
NH_SCCACHE_AWS_ACCESS_KEY_ID=R74SNIY3OLH45CN19OWC
NH_SCCACHE_AWS_SECRET_ACCESS_KEY=4rsA7lOZU0JbX81SZSTQ3nDs2ZslKlcvPdIgdOMP

# Read-through mirror of third-party downloads (getdeps fetcher.py, kernel
# cache_source.py).
NH_STATIC_DEPS_HTTP=http://bucket.internal.nexthop.ai:7480/vol-shared/fboss/static_deps
NH_STATIC_DEPS_S3=s3://vol-shared/fboss/static_deps
NH_STATIC_DEPS_ENDPOINT=http://bucket.internal.nexthop.ai:7480

# RPM mirror for the kiwi image repositories (mirror-fallback.sh), scheme+host only.
NH_RPM_MIRROR=http://mirror.us-west-1.nexthop.ai
