"""Hand-written SAI flavor targets — not generated by bazelify.

Declares the sai_impl string flag and the config_settings that select()
expressions in *_impl.bzl files branch on.

  //fboss/agent/hw/sai:sai_impl   — the flag (default "bcm")
  //fboss/agent/hw/sai:is_bcm     — true when sai_impl=bcm
  //fboss/agent/hw/sai:is_fake    — true when sai_impl=fake

Select the flavor via bazel.sh: `bazel.sh build --sai fake ...`.
"""

load("@bazel_skylib//rules:common_settings.bzl", "string_flag")

string_flag(
    name = "sai_impl",
    build_setting_default = "bcm",
    values = [
        "bcm",
        "fake",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "is_bcm",
    flag_values = {":sai_impl": "bcm"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "is_fake",
    flag_values = {":sai_impl": "fake"},
    visibility = ["//visibility:public"],
)
