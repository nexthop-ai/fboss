# We explicitly place the intermediate build products into the
# source tree to help incremental rebuild speed. This is both to make
# incremental rebuild calculations faster, but also to avoid
# unnecessary rebuilds when, say, an intermediate file is deleted.
genrule(
    name = "fboss_builder_docker",
    visibility = ["//visibility:public"],
    srcs = [
        "//fboss/fboss-image/distro_cli:scripts/build_and_tag_docker.sh",
        "fboss/oss/scripts/build_docker.sh",
        "fboss/oss/docker/Dockerfile",
        ".dockerignore",
    ] + glob(["build/**"],
        exclude=["build/**/*.pyc"]),
    outs = ["fboss_builder.tar"],
    cmd = SELECT_REGION_CMD + """
        $(location //fboss/fboss-image/distro_cli:scripts/build_and_tag_docker.sh)
        docker save -o fboss_builder.tar fboss_builder:latest
        mv fboss_builder.tar $(RULEDIR)
    """,
    tags = ["no-sandbox"]
)

sh_library(
    name = "run_in_builder",
    visibility = ["//visibility:public"],
    srcs = ["fboss/oss/scripts/run_in_builder.sh"],
    # Written by set-region.sh; absent until a region is selected.
    data = glob(
        [
            "fboss/oss/scripts/region.env",
            "fboss/oss/scripts/region.repo",
        ],
        allow_empty = True,
    ),
)

# The per-region config files, plus the two links when a region is already
# selected (absent otherwise). Input of the sandboxed image compositions.
filegroup(
    name = "region_config",
    visibility = ["//visibility:public"],
    srcs = glob(["fboss/oss/scripts/regions/*"]) + glob(
        [
            "fboss/oss/scripts/region.env",
            "fboss/oss/scripts/region.repo",
        ],
        allow_empty = True,
    ),
)

# bazel run //fboss:set_region -- <region>
sh_binary(
