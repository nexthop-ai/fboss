# Committed image_builder sources (scripts, kiwi configs, rootfs templates)
# consumed by the final image assembly step.
filegroup(
    name = "image_builder",
    srcs = glob(
        ["fboss-image/image_builder/**"],
        exclude = [
            "fboss-image/image_builder/templates/centos-09.0/root/**",
            "fboss-image/image_builder/templates/centos-09.0/root_files/etc/nexthop_build_info",
            "fboss-image/image_builder/templates/centos-09.0/after_pkgs_install_file.json",
            "fboss-image/image_builder/output/**",
            "fboss-image/image_builder/logs/**",
            "fboss-image/image_builder/deps_staging/**",
        ],
    ),
)

heavy_genrule(
    name = "nh-fboss-broadcom-xgs",
    stamp = True,
    srcs = [
        "//fboss/fboss-image/bgp_pp:distro_bgp_pp.rpm",
        "//bazel_lib:ln_or_cp",
        "//fboss_bsps/nexthop_bsp:distro_nexthop_bsp.tar",
        "//fboss_bsps/fboss_bsp_kmods:distro_fboss_bsp.tar",
        "//fboss_extras/nexthop_product_support:distro_nexthop_product_support.rpm",
        "//nhbroadcomsai/fboss-xgs:distro_sai.tar",
        ":fboss_builder_docker", # Prevent concurrent building
        "distro_kernel_6.11.tar",
        "fboss_platform_stack.tar",
        "fboss_forwarding_stack_broadcom_xgs.tar",
        ":image_builder",
        "CMakeLists.txt",
        "functions.cmake",
        "sdk_dependencies.txt",
    ],
    outs = [
        "nh-fboss-broadcom-xgs.bin",
        "nh-fboss-broadcom-xgs.tar",
    ],
    cmd = LOAD_FBOSS_BUILDER_CMD + """
        BUILD_DIR="fboss/fboss-image/.nh-broadcom-xgs"
        mkdir -p "${BUILD_DIR}"

        ln -f $(location distro_kernel_6.11.tar) "${BUILD_DIR}/distro_kernel_6.11.tar"
        ln -f $(location //nhbroadcomsai/fboss-xgs:distro_sai.tar) "${BUILD_DIR}/distro_sai.tar"
        ln -f $(location //fboss_extras/nexthop_product_support:distro_nexthop_product_support.rpm) "${BUILD_DIR}/distro_nexthop_product_support.rpm"
        ln -f $(location //fboss_bsps/fboss_bsp_kmods:distro_fboss_bsp.tar) "${BUILD_DIR}/distro_fboss_bsp.tar"
        ln -f $(location //fboss_bsps/nexthop_bsp:distro_nexthop_bsp.tar) "${BUILD_DIR}/distro_nexthop_bsp.tar"
        ln -f $(location fboss_platform_stack.tar) "${BUILD_DIR}/fboss_platform_stack.tar"
        ln -f $(location //fboss/fboss-image/bgp_pp:distro_bgp_pp.rpm) "${BUILD_DIR}/distro_bgp_pp.rpm"
        ln -f $(location fboss_forwarding_stack_broadcom_xgs.tar) "${BUILD_DIR}/forwarding-stack.tar"

        BUILD_INFO="fboss/fboss-image/image_builder/templates/centos-09.0/root_files/etc/nexthop_build_info"
        mkdir -p "${BUILD_INFO%/*}"
        grep \\
            -e 'BUILD_ID ' \\
            -e 'GIT_COMMIT_NH ' \\
            -e 'GIT_COMMIT_FBOSS ' \\
            -e 'GIT_COMMIT_FBOSS_BSPS_FBOSS_BSP_KMODS ' \\
            -e 'GIT_COMMIT_NHBROADCOMSAI_FBOSS_XGS ' \\
            bazel-out/volatile-status.txt > "${BUILD_INFO}"

        pushd fboss/fboss-image
        ./distro_cli/fboss-image build nh-fboss-broadcom-xgs.json 2>&1
        popd

        $(execpath //bazel_lib:ln_or_cp) fboss/fboss-image/nh-fboss-broadcom-xgs.tar $(location nh-fboss-broadcom-xgs.tar)
        $(execpath //bazel_lib:ln_or_cp) fboss/fboss-image/nh-fboss-broadcom-xgs.bin $(location nh-fboss-broadcom-xgs.bin)
    """,
    tags = ["no-sandbox"],
)

heavy_genrule(
    name = "compress_test_artifacts",
    needs = "all_cpus",
    srcs = [
        "fboss_forwarding_stack_tests_broadcom_xgs.tar",
        "fboss_forwarding_stack_tests_cisco_s1.tar",
        "fboss_platform_stack_tests.tar",
    ],
    outs = [
        "fboss_forwarding_stack_tests_broadcom_xgs.tar.zst",
        "fboss_forwarding_stack_tests_cisco_s1.tar.zst",
        "fboss_platform_stack_tests.tar.zst",
    ],
    cmd = """
        zstd -T0 -19 -f -o $(location fboss_forwarding_stack_tests_broadcom_xgs.tar.zst) $(location fboss_forwarding_stack_tests_broadcom_xgs.tar)
        zstd -T0 -19 -f -o $(location fboss_forwarding_stack_tests_cisco_s1.tar.zst) $(location fboss_forwarding_stack_tests_cisco_s1.tar)
        zstd -T0 -19 -f -o $(location fboss_platform_stack_tests.tar.zst) $(location fboss_platform_stack_tests.tar)
    """,
)

