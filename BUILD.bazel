    srcs = ["fboss/oss/scripts/set-region.sh"],
    data = glob(["fboss/oss/scripts/regions/*"]),
)

heavy_genrule(
    name = "fboss-fake-sai",
    srcs = [
        "//bazel_lib:ln_or_cp",
        "//fboss:fboss_builder.tar",
        ".buckconfig",
        "CMakeLists.txt",
        "buck2",
        "functions.cmake",
        "getdeps.sh",
        "sdk_dependencies.txt",
    ] + glob(["build/**", # Avoid dot files, especially .sccache to which bazel doesn't have permission
              "cmake/**",
              "common/**",
              "docs/**",
              "fboss/**",
    ]) + [
        # See fboss_forwarding_stack_srcs.
        "//fboss/fboss/agent/hw/sai:stack_srcs",
    ],
    outs = [
        "fboss-fake-sai.tar.zst",
        "api_test",
        "async_logger_test",
        "fboss2_cmd_test",
        "fsdb_client_test",
        "platform_config_lib_config_lib_test",
        "platform_data_corral_sw_test",
        "platform_helpers_platform_name_lib_test",
        "platform_manager_config_validator_test",
        "platform_manager_data_store_test",
        "platform_manager_exploration_errors_test",
        "platform_manager_i2c_explorer_test",
        "platform_manager_platform_explorer_test",
        "platform_manager_presence_checker_test",
        "platform_manager_utils_test",
        "rackmon_test",
        "sensor_service_sw_test",
        "sensor_service_utils_test",
        "store_test",
        "switch_test",
        "thrift_node_tests",
        "weutil_crc16_ccitt_test",
        "weutil_fboss_eeprom_interface_test",
    ],
    cmd = LOAD_FBOSS_BUILDER_CMD + """
        pushd fboss
        mkdir -p .build_dir/sai .sccache
        tar -C .build_dir/sai -xf ./fboss/oss/scripts/fake-sai-devel.tar

        ./fboss/oss/scripts/run_in_builder.sh ./fboss/oss/scripts/build.sh
        popd

        for out in $(OUTS); do
            filename=$$(basename $$out)
            if [ $$filename = "fboss-fake-sai.tar.zst" ]; then
                $(execpath //bazel_lib:ln_or_cp) fboss/fboss_bins.tar.zst $(location fboss-fake-sai.tar.zst)
            else
                $(execpath //bazel_lib:ln_or_cp) fboss/.build_dir/sai-fake/build/fboss/$$filename $(RULEDIR)/$$filename
            fi
        done
    """,
    tags = [
        "no-sandbox",
        "not-for-ci",
    ],
)

