sh_test(
    name = "cfboss_dataplane_test",
    srcs = ["cfboss/tests/run_cfboss_dataplane_test.sh"],
    data = [
        ":nh-fboss-cfboss.tar.xz",
        "cfboss/scripts/run_cfboss.sh",
        "cfboss/tests/validate_dataplane.sh",
    ],
    size = "enormous",
    # exclusive: the test claims a fixed-name container and mutates that
    # container's netns, so it must not run concurrently with other tests.
    # No spawn-strategy tag (local/no-sandbox): the CI's allowed test
    # strategies are remote/worker/linux-sandbox/processwrapper-sandbox only,
    # so a strategy-forcing tag leaves the spawn unrunnable — and none is
    # needed, since the host docker daemon is reachable from linux-sandbox
    # (the unittest-* targets drive docker the same way).
    tags = [
        "exclusive",
        "resources:docker_test_clients:1",
        "requires-network",
    ],
)

