load("//fboss:fboss_build_types.bzl", "fboss_unit_test")

# We explicitly place the intermediate build products into the
# source tree to help incremental rebuild speed. This is both to make
# incremental rebuild calculations faster, but also to avoid
# unnecessary rebuilds when, say, an intermediate file is deleted.
genrule(
    name = "fboss_builder_docker",
    visibility = ["//visibility:public"],
    srcs = [
        "fboss/oss/scripts/build_docker.sh",
        "fboss/oss/docker/Dockerfile.builder",
        "fboss/oss/docker/Dockerfile.builder.dockerignore",
    ] + glob(["build/**"]),
    outs = ["fboss_builder.tar"],
    cmd = """
        $(SRCS)/fboss/oss/scripts/build_docker.sh
        docker save -o fboss_builder.tar fboss_builder
        mv fboss_builder.tar $(RULEDIR)
    """,
    local=True,
)

sh_library(
    name = "run_in_builder",
    visibility = ["//visibility:public"],
    srcs = ["fboss/oss/scripts/run_in_builder.sh"],
)

genrule(
    name = "fboss-fake-sai",
    srcs = [
        "//fboss:fboss_builder.tar",
        ".buckconfig",
        "CMakeLists.txt",
        "buck2",
        "functions.cmake",
        "getdeps.sh",
        "sdk_dependencies.txt",
    ] + glob(["build/**", # Avoid dot files, especially .sccache to which bazel doesn't have permission
              "cmake/**",
              "common/**",
              "docs/**",
              "fboss/**",
    ]),
    outs = [
        "fboss-fake-sai.tar.zst",
        "api_test",
        "async_logger_test",
        "fboss2_cmd_test",
        "fsdb_client_test",
        "platform_config_lib_config_lib_test",
        "platform_data_corral_sw_test",
        "platform_helpers_platform_name_lib_test",
        "platform_manager_config_validator_test",
        "platform_manager_data_store_test",
        "platform_manager_i2c_explorer_test",
        "platform_manager_platform_explorer_test",
        "platform_manager_presence_checker_test",
        "platform_manager_utils_test",
        "rackmon_test",
        "sensor_service_sw_test",
        "sensor_service_utils_test",
        "store_test",
        "switch_test",
        "thrift_node_tests",
        "weutil_crc16_ccitt_test",
        "weutil_fboss_eeprom_interface_test",
    ],
    cmd = """
        if ! $$(docker images | grep -q fboss_builder); then
            cat $(location //fboss:fboss_builder.tar) | docker image load
        fi

        pushd fboss
        mkdir -p .build_dir/sai .sccache
        tar -C .build_dir/sai -xf ./fboss/oss/scripts/fake-sai-devel.tar.zstd

        ./fboss/oss/scripts/run_in_builder.sh ./fboss/oss/scripts/build.sh
        popd

        for out in $(OUTS); do
            filename=$$(basename $$out)
            if [ $$filename = "fboss-fake-sai.tar.zst" ]; then
                cp fboss/fboss_bins.tar.zst $(location fboss-fake-sai.tar.zst)
            else
                cp fboss/.build_dir/sai-fake/build/fboss/$$filename $(RULEDIR)/$$filename
            fi
        done
    """,
    tags = [
        "no-sandbox",
        "not-for-ci",
    ]
)

