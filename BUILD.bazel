heavy_genrule(
    name = "distro_kernel_6.11",
    visibility = ["//visibility:public"],
    needs = "all_cpus",
    srcs = [
        "//bazel_lib:ln_or_cp",
        "//fboss/fboss-image/distro_cli:builder",
        "//fboss:nh-fboss-manifests",
        ":fboss_builder_docker",
    ] + glob([
        "fboss-image/kernel/configs/**",
        "fboss-image/kernel/env/**",
        "fboss-image/kernel/scripts/**",
        "fboss-image/kernel/specs/**",
    ]),
    outs = ["distro_kernel_6.11.tar"],
    cmd = LOAD_FBOSS_BUILDER_CMD + """
        pushd fboss/fboss-image
        jq '.["kernel"] = {"execute": ["kernel/scripts/build_kernel.sh", "6.11.1", "/output"]}' nh-fboss-broadcom-xgs.json > kernel.json
        ./distro_cli/fboss-image build kernel.json kernel
        popd

        $(execpath //bazel_lib:ln_or_cp) fboss/fboss-image/kernel/dist/kernel-6.11.1.rpms.tar $(location distro_kernel_6.11.tar)
    """,
    tags = ["no-sandbox"],
)

heavy_genrule(
    name = "fboss_platform_stack",
    visibility = ["//visibility:public"],
    srcs = [
        "//bazel_lib:ln_or_cp",
        "//fboss/fboss-image/distro_cli:builder",
        "//fboss:nh-fboss-manifests",
        ":fboss_builder_docker", # Prevent concurrent building
        "CMakeLists.txt",
        "functions.cmake",
        "sdk_dependencies.txt",
    ] + glob([
        "build/**",
        "cmake/**",
        "common/**",
        # fboss code needed for platform stack
        "fboss/docs/**",
        "fboss/fsdb/**",
        "fboss/lib/**",
        "fboss/oss/**",
        "fboss/platform/**",
        "fboss/py/**",
        "fboss/qsfp_service/**",
        "fboss/scripts/**",
        "fboss/thrift_cow/**",
        "fboss/thrift_visitors/**",
        "fboss/thriftpath_plugin/**",
        "fboss/util/**",
    ], exclude = [
        "build/buck2/**",
        # exclude generated distro artifacts dir inside fboss/oss
        "fboss/oss/scripts/dist/**",
        "**/*.swp",
        "**/*.swo",
        "**/*~",
        "**/__pycache__/**",
        "**/*.pyc",
    ]),
    outs = [
        "fboss_platform_stack.tar",
        "fboss_platform_stack_tests.tar",
    ],
    cmd = LOAD_FBOSS_BUILDER_CMD + """
        pushd fboss/fboss-image
        jq '.["fboss-platform-stack"] = {"execute": ["../fboss/oss/scripts/nhfboss-stack.sh", "platform"]}' nh-fboss-broadcom-xgs.json > platform-stack.json
        ./distro_cli/fboss-image build platform-stack.json fboss-platform-stack
