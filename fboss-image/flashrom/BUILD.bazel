# Bazel package for flashrom.
# distro_flashrom builds the flashrom RPM once and is shared across the
# fboss image targets so the same RPM is reused instead of rebuilt per image.
load("//fboss:fboss_build_types.bzl", "distro_build")

distro_build(
    name = "distro_flashrom",
    artifact = "flashrom-1.7.0-1.x86_64.rpm",
    component = "other_dependencies",
    execute = ["flashrom/build.sh"],
    manifest = "nh-fboss-broadcom-xgs.json",
    needs = "one_core",
    outs_map = {"distro_flashrom.rpm": "fboss/fboss-image/flashrom/dist/flashrom-1.7.0-1.x86_64.rpm"},
    srcs = [
        "build.sh",
        "rpmbuild/SPECS/flashrom.spec",
    ],
    visibility = ["//fboss:__subpackages__"],
)
