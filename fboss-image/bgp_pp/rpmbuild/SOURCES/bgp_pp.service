[Unit]
Description=Meta bgp++ routing daemon
# Advisory ordering: bgpd_cpp retries FibService connection internally,
# so strict dependency (Wants=) on fboss_sw_agent is not required.
After=network-online.target fboss_sw_agent.service
Wants=network-online.target

StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/sbin/bgpd_cpp --config /etc/bgp_pp/bgpcpp.conf --thrift_ssl_policy=disabled --logtostderr --fbwhoami_strict=false --route_watcher=false --enable_configerator_client_ods_logging=false --ods3_sdk_enable_publishing=false --disable_scribe_producer_metrics=true
Restart=always
RestartSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bgp_pp

[Install]
WantedBy=multi-user.target
