load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files([
    "ruff.toml",
    "scripts/build_and_tag_docker.sh",
])

filegroup(
    name = "builder",
    visibility = ["//visibility:public"],
    srcs = glob(
        ["**"],
        exclude = [
            ".artifacts/**",
            "**/__pycache__/**",
            "**/*.pyc",
            "**/*.swp",
            "**/*.swo",
            "**/*~",
        ],
    ),
)

# Shared library containing all the distro_cli code
py_library(
    name = "distro_cli_lib",
    srcs = glob(
        ["**/*.py"],
        exclude = ["tests/**/*.py"],
    ),
    imports = [".."],
    visibility = ["//visibility:public"],
)

# Shared test helpers library
py_library(
    name = "test_helpers",
    srcs = ["tests/test_helpers.py"],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [":distro_cli_lib"],
)

py_test(
    name = "manifest_test",
    srcs = ["tests/manifest_test.py"],
    imports = [".."],
    deps = [":distro_cli_lib"],
    data = glob(["tests/data/*.json"]),
    main = "tests/manifest_test.py",
    python_version = "PY3",
    srcs_version = "PY3",
    size = "small",
)

py_test(
    name = "image_builder_test",
    srcs = ["tests/image_builder_test.py"],
    imports = [".."],
    deps = [
        ":distro_cli_lib",
        ":test_helpers",
    ],
    data = glob(["tests/data/*.json"]),
    main = "tests/image_builder_test.py",
    python_version = "PY3",
    srcs_version = "PY3",
    size = "medium",
    tags = ["disabled"],  # Fails due to read-only filesystem
)

py_test(
    name = "build_test",
    srcs = ["tests/build_test.py"],
    imports = [".."],
    deps = [
        ":distro_cli_lib",
        ":test_helpers",
    ],
    data = glob(["tests/data/*.json", "tests/data/**/*.sh"], allow_empty = True),
    main = "tests/build_test.py",
    python_version = "PY3",
    srcs_version = "PY3",
    size = "medium",
    tags = ["disabled"], # Fails due to read-only filesystem
)

py_test(
    name = "device_test",
    srcs = ["tests/device_test.py"],
    imports = [".."],
    deps = [
        ":distro_cli_lib",
        ":test_helpers",
    ],
    data = glob([
        "tests/data/*.json",
        "tests/data/artifacts/*.tar.zst",
    ]) + [
        "scripts/update_component.sh",
        "//fboss/fboss-image/distro_infra:distro_infra_docker_image",
    ],
    main = "tests/device_test.py",
    python_version = "PY3",
    srcs_version = "PY3",
    size = "medium",
)

sh_test(
    name = "device_integration_test",
    srcs = ["tests/run_device_integration_test.sh"],
    data = glob([
        "tests/data/*.json",
        "tests/test_topology/integration_data/*.json",
        "tests/test_topology/integration_data/*.sh",
        "tests/test_topology/integration_data/*.tar",
    ]) + [
        "scripts/update_component.sh",
        "tests/test_topology/start.sh",
        "tests/device_integration_test.py",
        "//fboss/fboss-image/distro_cli/tests/proxy_device:proxy_device_files",
        "//fboss:fboss_builder_docker",
        "//fboss/fboss-image/distro_cli/tests/proxy_device:proxy_device_docker_image",
        ":distro_cli_lib",
        ":test_helpers",
    ],
    size = "large",
    tags = ["requires-network"]
)

