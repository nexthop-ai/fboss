# Bazel package for bgpd (bgp++ routing daemon).
load("//fboss:fboss_build_types.bzl", "LOAD_FBOSS_BUILDER_CMD")

genrule(
    name = "distro_bgpd",
    visibility = ["//fboss:__subpackages__"],
    srcs = [
        # NOTE: @bgp_pp_tarball still uses the old name because the S3 artifact
        # has not been renamed yet.
        "@bgp_pp_tarball//file",
        "//bazel_lib:ln_or_cp",
        "//fboss/fboss-image/distro_cli:builder",
        "//fboss:fboss_builder_docker",
        "//fboss:nh-fboss-manifests",
        "build.sh",
        "rpmbuild/SPECS/bgpd.spec",
        "rpmbuild/SOURCES/bgpd.service",
    ],
    outs = ["distro_bgpd.rpm"],
    cmd = LOAD_FBOSS_BUILDER_CMD + """
        # NOTE: tarball filename is still bgp_pp-1.0.tar.gz — the S3 artifact has not been renamed yet.
        ln -f $(location @bgp_pp_tarball//file) fboss/fboss-image/bgpd/rpmbuild/SOURCES/bgp_pp-1.0.tar.gz
        pushd fboss/fboss-image
        jq '.["other_dependencies"] = [{"execute": ["bgpd/build.sh"], "artifact": "bgpd-1.0-1.x86_64.rpm"}]' nh-fboss-broadcom-xgs.json > bgpd.json
        ./distro_cli/fboss-image build bgpd.json other_dependencies
        popd

        $(execpath //bazel_lib:ln_or_cp) fboss/fboss-image/bgpd/rpmbuild/RPMS/x86_64/bgpd-*.x86_64.rpm $(location distro_bgpd.rpm)
    """,
    tags = ["no-sandbox"],
)
