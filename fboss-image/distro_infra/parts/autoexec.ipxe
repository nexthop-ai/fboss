#!ipxe

dhcp

set hbase http://${next-server}:6969/${net0/mac:hexhyp}
set tbase tftp://${next-server}

set stub_name FBOSS-Distro-Image.x86_64-1.0

initrd ${hbase}/pxeboot.${stub_name}.initrd

# Download the kernel over TFTP so we can use it as a signal to remove the dnsmasq configuration
kernel ${tbase}/pxeboot.${stub_name}.kernel console=ttyS4,57600n8 nomodeset rd.neednet=1 rd.kiwi.install.pxe ip=eno1:dhcp ipv6.disable=1 rd.kiwi.install.image=${hbase}/${stub_name}.xz rd.kiwi.install.target=/dev/nvme0n1

boot
