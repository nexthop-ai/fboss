exports_files([
    "build.sh",
    "Dockerfile",
    "distro_infra.sh",
])

filegroup(
    name = "distro_infra_files",
    srcs = glob(
        ["**/*"],
        exclude = [
            "parts/ipxe/ipxe/**",
            "parts/ipxe/*.efi",
            "**/.*",
            "**/.*/**",
        ],
    ),
    visibility = ["//visibility:public"],
)

genrule(
    name = "distro_infra_docker_image",
    srcs = [":distro_infra_files"],
    outs = ["distro_infra_image.tar"],
    tags = ["no-sandbox"],
    cmd = """
        set -euo pipefail

        IMAGE_NAME="fboss_distro_infra"
        OUTPUT_TAR="$@"

        pushd fboss/fboss-image/distro_infra > /dev/null
        ./build.sh
        popd > /dev/null

        mkdir -p $$(dirname "$$OUTPUT_TAR")
        docker save -o "$$OUTPUT_TAR" "$$IMAGE_NAME"
        ls -lh "$$OUTPUT_TAR"
    """,
    visibility = ["//visibility:public"],
)
