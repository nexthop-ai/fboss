{
  "distribution_formats": {
    "pxe": "nh-fboss-broadcom-xgs.tar",
    "onie": "nh-fboss-broadcom-xgs.bin"
  },
  "kernel": {
    "download": "file:distro_kernel_6.11.tar"
  },
  "other_dependencies": [
      {"execute": ["../../fboss_extras/asic_init/distro_build.sh"]}
  ],
  "fboss-platform-stack": {
    "execute": ["../fboss/oss/scripts/nhfboss-stack.sh", "platform"],
    "artifact": "platform-stack.tar"
  },
  "bsps": [
      {"execute": "../../fboss_bsps/nexthop_bsp/distro_build.sh"},
      {"execute": "../../fboss_bsps/fboss_bsp_kmods/distro_build.sh"}
  ],
  "hw_agent_sai": {
    "download": "file:distro_sai.tar"
  },
  "qsfp_service_sai": {
  },
  "fboss-forwarding-stack": {
    "execute": ["../fboss/oss/scripts/nhfboss-stack.sh", "forwarding"],
    "artifact": "forwarding-stack.tar"
  },
  "image_build_hooks": {
     "after_pkgs_install": "nexthop-extra-pkgs.json"
  }
}
