# Hand-written BUILD file for the BGP++ bgp_route_types thrift types.
#
# NOTE: committed as BUILD.bazel.oss and copied to BUILD.bazel by
# fboss/oss/scripts/bazel.sh at build time. It is NOT committed as BUILD.bazel
# because the Monobuild (nh.git, this repo is a submodule there) would discover
# it during //... expansion and fail on its load("//fboss/build_defs:...")
# label, which does not resolve in that workspace. BUILD.bazel.oss is not a
# Bazel package marker, so the Monobuild ignores it.
#
# This package lives under neteng/, outside bazelify.py's BUCK scan (fboss/,
# build/, common/), so its BUILD.bazel is hand-written -- same as
# configerator/structs/neteng/fboss/thrift/BUILD.bazel. fsdb_model.thrift
# includes bgp_route_types.thrift directly; see cmake/fsdb/FsdbIf.cmake
# (add_fbthrift_cpp_library bgp_route_types_cpp2) for the equivalent wiring.
#
# bgp_route_types is pulled in transitively by fsdb_model; bgp_thrift (and its
# TBgpService) is needed by the fboss2 BGP CLI show commands. The fboss2 BUCK
# targets reference //neteng/fboss/bgp/if:bgp_thrift-cpp2-{types,services}, but
# bazelify.py strips //neteng/ deps, so those targets re-add this dep via
# `# bazelify: extra_dep = //neteng/fboss/bgp/if:bgp_thrift` annotations. The
# deps below mirror cmake/fsdb/FsdbIf.cmake (bgp_thrift_cpp2 / policy_thrift_cpp2).
#
# The remaining BGP++ neteng/fboss/bgp/if BUCK targets (bgp-structs, bgp_stream,
# ...) are not needed by the OSS build and are annotated # bazelify: exclude-all
# in the BUCK.

load("//fboss/build_defs:thrift_library.bzl", "fboss_thrift_library")

fboss_thrift_library(
    name = "bgp_route_types",
    thrift_srcs = ["bgp_route_types.thrift"],
    thrift_cpp2_options = "json,reflection",
    deps = [
        "//configerator/structs/neteng/bgp_policy/thrift:rib_policy",
        "//configerator/structs/neteng/fboss/bgp/if:bgp_attr",
    ],
    visibility = ["//visibility:public"],
)

fboss_thrift_library(
    name = "policy_thrift",
    thrift_srcs = ["policy_thrift.thrift"],
    thrift_cpp2_options = "json,reflection",
    visibility = ["//visibility:public"],
)

fboss_thrift_library(
    name = "bgp_thrift",
    thrift_srcs = {"bgp_thrift.thrift": ["TBgpService"]},
    thrift_cpp2_options = "json,reflection",
    deps = [
        ":bgp_route_types",
        ":policy_thrift",
        "//common/fb303/if:fb303",
        "//configerator/structs/neteng/bgp_policy/thrift:bgp_policy",
        "//configerator/structs/neteng/bgp_policy/thrift:rib_policy",
        "//neteng/fboss/bgp/public_tld/configerator/structs/neteng/fboss/bgp:bgp_config_oss",
        "//configerator/structs/neteng/fboss/bgp/if:bgp_attr",
    ],
    visibility = ["//visibility:public"],
)
