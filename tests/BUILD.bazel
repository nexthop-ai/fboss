load("@rules_python//python:defs.bzl", "py_library")

# Test runner runs within the nhtests-run environment, use the same python libs
_PIP = "@nhtools_itests_pip//"

# Runner files whose test_context["filters"] are checked by
# //fboss:filter_overlap_test. The unit tests under
# libs/test_runner/unittests/ are their own package, so this glob does not
# reach them.
filegroup(
    name = "runner_py_srcs",
    srcs = glob(["**/*.py"]),
    visibility = ["//fboss:__pkg__"],
)

# The runner package under test, plus the tests.libs.device SSH/SCP helpers it
# imports and the __init__ files that make `tests.libs.*` importable at all.
# libs/test_runner/unittests is its own package, so the glob stops short of it.
py_library(
    name = "test_runner",
    srcs = [
        "__init__.py",
        "libs/__init__.py",
    ] + glob([
        "libs/test_runner/**/*.py",
        "libs/device/*.py",
    ]),
    imports = [".."],
    visibility = ["//fboss/tests:__subpackages__"],
    deps = [
        _PIP + "paramiko",
        _PIP + "pexpect",
        _PIP + "scp",
        _PIP + "waiting",
    ],
)

# Hardware test modules the manifest-consistency guards exec by path: the
# benchmark buckets and the link/qsfp variant wrappers. They live in this
# package, so the unit-test package below cannot glob them itself.
filegroup(
    name = "hw_test_modules",
    srcs = glob([
        "agent_hw/benchmarks/*.py",
        "link/*.py",
        "qsfp/*.py",
    ]),
    visibility = ["//fboss/tests:__subpackages__"],
)
